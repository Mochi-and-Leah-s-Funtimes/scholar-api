{
  "name": "scholarapi",
  "version": "1.0.0",
  "description": "CLI for the Semantic Scholar API",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "scholar": "src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src/**/*.ts"
  },
  "keywords": [
